{
  "name": "brandsparq",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "deploy:worker": "npm run build && npm --prefix cloudflare install --legacy-peer-deps && npm --prefix cloudflare run deploy",
    "deploy:cloudflare": "npm run deploy:worker",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.20",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^57.0.21",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~15.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.0",
    "expo-image-manipulator": "~57.0.17"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
