{
  "expo": {
    "name": "BrandSparQ",
    "slug": "brandsparq",
    "scheme": "brandsparq",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F8FF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphazonelabs.brandsparq",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alphazonelabs.brandsparq",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BrandSparQ uses your photos to create marketing content.",
          "cameraPermission": "BrandSparQ uses your camera to capture marketing content.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
