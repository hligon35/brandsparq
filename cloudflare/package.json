{
  "name": "@brandsparq/api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix .. run deploy:production",
    "typecheck": "tsc --noEmit",
    "build": "npm --prefix .. run build:cloudflare",
    "deploy:staging": "wrangler deploy --config wrangler.staging.toml",
    "migrate:staging": "wrangler d1 migrations apply brandsparq-staging --remote --config wrangler.staging.toml && wrangler d1 execute brandsparq-staging --remote --config wrangler.staging.toml --file staging-init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
