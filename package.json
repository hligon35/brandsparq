{
  "name": "brandsparq",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "deploy:worker": "npm run validate && npm --prefix cloudflare run deploy",
    "deploy:cloudflare": "npm run deploy:worker",
    "typecheck": "tsc --noEmit",
    "validate": "npm run schema:check && npx expo install --check && npm run audit:launch && npm run lint && npm run format:check && npm test && npm run typecheck && npm --prefix cloudflare run typecheck && npm run build:web && npm run test:e2e",
    "deploy:production": "npm run validate && npm --prefix cloudflare run deploy",
    "audit:launch": "node scripts/launch-audit.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:unit": "node --import ./tests/register.mjs --test tests/unit.test.mjs",
    "test:integration": "node --import ./tests/register.mjs --test tests/launch.test.mjs tests/providers.test.mjs tests/workflow-safety.test.mjs tests/workspace-experience.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:mobile": "node scripts/test-mobile.mjs",
    "test:workspace": "node --import ./tests/register.mjs tests/e2e/server.mjs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "build:cloudflare": "npm ci --prefix cloudflare && npm run build:web",
    "schema:generate": "node scripts/schema-manifest.mjs",
    "schema:check": "node scripts/schema-manifest.mjs --check",
    "configure:staging": "node --env-file-if-exists=.env.sandbox scripts/staging-config.mjs",
    "deploy:staging": "node --env-file-if-exists=.env.sandbox scripts/deploy-staging.mjs",
    "migrate:staging": "npm run configure:staging && npm --prefix cloudflare run migrate:staging",
    "verify:restore": "node scripts/verify-restore.mjs",
    "smoke:routing": "node scripts/check-access-routing.mjs",
    "dev:mobile": "expo start --dev-client --clear",
    "dev:tunnel": "expo start --dev-client --clear --tunnel",
    "build:dev:ios": "npx eas-cli@latest build --platform ios --profile development",
    "build:dev:android": "npx eas-cli@latest build --platform android --profile development",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:prod:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:prod:android": "npx eas-cli@latest build --platform android --profile production",
    "ota:dev": "npx eas-cli@latest update --channel development --environment development",
    "ota:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "ota:production": "npx eas-cli@latest update --channel production --environment production",
    "ota:configure": "npx eas-cli@latest update:configure"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.56.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
