{
  "expo": {
    "name": "BrandSparQ",
    "slug": "brandsparq",
    "scheme": "brandsparq",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F8FF",
    "icon": "./assets/brandsparqIcon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphazonelabs.brandsparq",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alphazonelabs.brandsparq",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FF",
        "foregroundImage": "./assets/brandsparqIcon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brandsparqFavicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BrandSparQ uses your photos to create marketing content.",
          "cameraPermission": "BrandSparQ uses your camera to capture marketing content.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brandsparqFavicon.png",
          "color": "#0B78F6"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "b3565213-5a78-44ed-855a-8fbd5fa74b94"
      }
    },
    "owner": "azlabsllc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3565213-5a78-44ed-855a-8fbd5fa74b94"
    }
  }
}
